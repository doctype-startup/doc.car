# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: nunca expor no client, só em variáveis de servidor (webhook)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=
# Developers > Webhooks > (endpoint) > Signing secret
STRIPE_WEBHOOK_SECRET=
# Product catalog > um produto/preço recorrente por plano > price id (ex: price_123...)
# Cotas e preços de cada plano ficam em lib/plans.ts — os price ids abaixo só
# precisam bater com o que foi cadastrado no Stripe pra cada um.
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=
STRIPE_PRICE_ESCRITORIO=

# Provedor de dados veiculares (consulta por placa) — token fornecido pelo provedor
PLACA_API_TOKEN=

# Consulta avançada (multas, roubo/furto, Renajud) — token fornecido pelo provedor,
# cobrado por consulta à parte da consulta normal acima
PLACA_DEBITOS_API_TOKEN=

# Infosimples — não usado hoje (endpoint de veículo não autorizado na conta atual);
# mantido caso a consulta de multas ANTT/SIFAMA seja retomada no futuro
INFOSIMPLES_TOKEN=
