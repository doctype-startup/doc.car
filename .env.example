# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: nunca expor no client, só em variáveis de servidor (webhook)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=
# Developers > Webhooks > (endpoint) > Signing secret
STRIPE_WEBHOOK_SECRET=
# Product catalog > (produto) > Pricing > price id (ex: price_123...)
STRIPE_PRICE_ID=

# Provedor de dados veiculares (consulta por placa) — token fornecido pelo provedor
PLACA_API_TOKEN=

# Infosimples — não usado hoje (endpoint de veículo não autorizado na conta atual);
# mantido caso a consulta de multas ANTT/SIFAMA seja retomada no futuro
INFOSIMPLES_TOKEN=
